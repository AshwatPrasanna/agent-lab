#!/bin/bash
# Agent Lab launcher: opens Agent Lab in your browser. If it isn't running yet, starts it
# through start.command in Terminal (which can be given access to the folder that holds Agent Lab);
# that Terminal window closes itself once Agent Lab is up. The agent-lab folder sits next to this app.
APP_PARENT="$(cd "$(dirname "$0")/../../.." && pwd -P)"
LAB="$APP_PARENT/agent-lab"
for alt in "$HOME/Documents/Claude Sandbox/agent-lab" "$HOME/Desktop/agent-lab"; do
  [ -d "$LAB/app" ] && break
  LAB="$alt"
done
URL="http://127.0.0.1:${AGENT_LAB_PORT:-8765}"
if /usr/bin/curl -s -m 1 -o /dev/null "$URL/api/status"; then
  /usr/bin/open "$URL"
else
  /usr/bin/open -a Terminal "$LAB/start.command"
fi
exit 0
