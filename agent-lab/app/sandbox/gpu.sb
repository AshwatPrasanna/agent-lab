(version 1)
;; Agent Lab GPU profile, used by app/bin/lab-gpu.
;; Starts from "allow" so Metal/MPS work, then fences user files and local services.
;; In SBPL the last matching rule wins, so each "allow" below re-opens part of a "deny" above it.
(allow default)

;; Files: no reading or writing of user data, except this job's workspace, the shared cache,
;; and any folders the user granted to this job (@GRANTS@, from jobs/<id>/access.txt).
(deny file-read* (subpath "/Users") (subpath "/Volumes"))
(allow file-read* (subpath "@WORK@") (subpath "@SHARED@")@GRANTS@)
(allow file-read-metadata @ANCESTORS@)
;; Agent Lab's settings (tokens) and runtime files stay unreadable, even inside a granted folder.
(deny file-read* (subpath "@LAB@/config") (subpath "@LAB@/runtime"))
(deny file-write* (subpath "/"))
(allow file-write* (subpath "/private/tmp") (subpath "/private/var/folders") (subpath "/dev")@GRANTS@)
;; Agent Lab's own files (code, other jobs, job records, the app icon) stay read-only, even inside a
;; granted folder. Then this job's workspace and the shared cache are opened again.
(deny file-write* (subpath "@LAB@") (subpath "@APPBUNDLE@"))
(allow file-write* (subpath "@WORK@") (subpath "@SHARED@"))

;; No driving other apps (they would run outside this sandbox).
(deny appleevent-send)
(deny mach-lookup (global-name "com.apple.coreservices.launchservicesd")
                  (global-name "com.apple.lsd.modifydb")
                  (global-name "com.apple.coreservices.appleevents"))
(deny process-exec (literal "/usr/bin/open") (literal "/usr/bin/osascript")
                   (literal "/usr/bin/automator") (literal "/usr/bin/shortcuts")
                   (literal "/usr/bin/sandbox-exec"))

;; No local services: Agent Lab's own API, Docker, anything listening on localhost.
(deny network-outbound (remote ip "localhost:*"))
(deny network-outbound (remote unix-socket (path-regex #"^/Users/")))
(deny network-outbound (remote unix-socket (path-literal "/private/var/run/docker.sock")))
